rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mouryar2410@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidAY(ay) {
      return ay is string && ay.size() >= 7 && ay.size() <= 9 && ay.matches('^[0-9]{4}-[0-9]{2,4}$');
    }

    // Validation Blueprint: Student
    function isValidStudent(data) {
      return data.keys().hasAll([
        'studentId', 'ownerId', 'rollNo', 'fullName', 'fatherName', 'phone',
        'stream', 'centerName', 'enrollmentAY', 'progressionAY', 'admissionClass',
        'classXIFee', 'classXIIFee', 'scholarshipDiscount', 'totalIntegratedFee',
        'paidClassXI', 'paidClassXII', 'totalPaid', 'xiPaymentDate', 'xiiPaymentDate',
        'status', 'remarks', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'studentId', 'ownerId', 'rollNo', 'fullName', 'fatherName', 'phone',
        'stream', 'centerName', 'enrollmentAY', 'progressionAY', 'admissionClass',
        'classXIFee', 'classXIIFee', 'scholarshipDiscount', 'totalIntegratedFee',
        'paidClassXI', 'paidClassXII', 'totalPaid', 'xiPaymentDate', 'xiiPaymentDate',
        'status', 'remarks', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.studentId) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.rollNo is string && data.rollNo.size() >= 1 && data.rollNo.size() <= 40 &&
      data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
      data.fatherName is string && data.fatherName.size() <= 120 &&
      data.phone is string && data.phone.size() <= 30 &&
      data.stream is string && data.stream.size() >= 1 && data.stream.size() <= 60 &&
      data.centerName is string && data.centerName.size() <= 80 &&
      isValidAY(data.enrollmentAY) &&
      isValidAY(data.progressionAY) &&
      data.admissionClass is string && (data.admissionClass == 'XI' || data.admissionClass == 'XII') &&
      data.classXIFee is number && data.classXIFee >= 0 && data.classXIFee <= 10000000 &&
      data.classXIIFee is number && data.classXIIFee >= 0 && data.classXIIFee <= 10000000 &&
      data.scholarshipDiscount is number && data.scholarshipDiscount >= 0 && data.scholarshipDiscount <= 10000000 &&
      data.totalIntegratedFee is number && data.totalIntegratedFee >= 0 && data.totalIntegratedFee <= 20000000 &&
      data.paidClassXI is number && data.paidClassXI >= 0 && data.paidClassXI <= 20000000 &&
      data.paidClassXII is number && data.paidClassXII >= 0 && data.paidClassXII <= 20000000 &&
      data.totalPaid is number && data.totalPaid >= 0 && data.totalPaid <= 20000000 &&
      data.xiPaymentDate is string && data.xiPaymentDate.size() <= 40 &&
      data.xiiPaymentDate is string && data.xiiPaymentDate.size() <= 40 &&
      data.status is string && (data.status == 'active' || data.status == 'completed' || data.status == 'dropped') &&
      data.remarks is string && data.remarks.size() <= 500 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: Payment
    function isValidPayment(data) {
      return data.keys().hasAll([
        'paymentId', 'studentId', 'ownerId', 'studentName', 'rollNo', 'stream',
        'enrollmentAY', 'progressionAY', 'recordedInAY', 'targetClass',
        'amount', 'allocatedToXI', 'allocatedToXII', 'paymentDate', 'paymentMode',
        'referenceNo', 'receiptNo', 'installmentLabel', 'notes',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'paymentId', 'studentId', 'ownerId', 'studentName', 'rollNo', 'stream',
        'enrollmentAY', 'progressionAY', 'recordedInAY', 'targetClass',
        'amount', 'allocatedToXI', 'allocatedToXII', 'paymentDate', 'paymentMode',
        'referenceNo', 'receiptNo', 'installmentLabel', 'notes',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.paymentId) &&
      isValidId(data.studentId) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120 &&
      data.rollNo is string && data.rollNo.size() >= 1 && data.rollNo.size() <= 40 &&
      data.stream is string && data.stream.size() >= 1 && data.stream.size() <= 60 &&
      isValidAY(data.enrollmentAY) &&
      isValidAY(data.progressionAY) &&
      isValidAY(data.recordedInAY) &&
      data.targetClass is string && (data.targetClass == 'XI' || data.targetClass == 'XII' || data.targetClass == 'INTEGRATED') &&
      data.amount is number && data.amount > 0 && data.amount <= 10000000 &&
      data.allocatedToXI is number && data.allocatedToXI >= 0 && data.allocatedToXI <= 10000000 &&
      data.allocatedToXII is number && data.allocatedToXII >= 0 && data.allocatedToXII <= 10000000 &&
      data.allocatedToXI + data.allocatedToXII == data.amount &&
      data.paymentDate is string && data.paymentDate.size() >= 1 && data.paymentDate.size() <= 30 &&
      data.paymentMode is string && (
        data.paymentMode == 'UPI' || data.paymentMode == 'NEFT/RTGS' ||
        data.paymentMode == 'Cheque' || data.paymentMode == 'Cash' ||
        data.paymentMode == 'Card' || data.paymentMode == 'DD'
      ) &&
      data.referenceNo is string && data.referenceNo.size() <= 80 &&
      data.receiptNo is string && data.receiptNo.size() >= 1 && data.receiptNo.size() <= 50 &&
      data.installmentLabel is string && data.installmentLabel.size() >= 1 && data.installmentLabel.size() <= 80 &&
      data.notes is string && data.notes.size() <= 300 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection: /students/{studentId}
    match /students/{studentId} {
      allow get: if isSignedIn() && isValidId(studentId) && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(studentId) &&
        isValidStudent(incoming()) &&
        incoming().studentId == studentId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(studentId) &&
        isValidStudent(incoming()) &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        incoming().studentId == existing().studentId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          // Action 1: Fee ledger synchronization
          (
            existing().status != 'completed' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'paidClassXI', 'paidClassXII', 'totalPaid', 'xiPaymentDate', 'xiiPaymentDate', 'status', 'remarks', 'updatedAt'
            ])
          ) ||
          // Action 2: Full student profile or fee structure edit
          (
            existing().status != 'completed' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'rollNo', 'fullName', 'fatherName', 'phone', 'stream', 'centerName',
              'enrollmentAY', 'progressionAY', 'admissionClass',
              'classXIFee', 'classXIIFee', 'scholarshipDiscount', 'totalIntegratedFee',
              'paidClassXI', 'paidClassXII', 'totalPaid', 'xiPaymentDate', 'xiiPaymentDate', 'status', 'remarks', 'updatedAt'
            ])
          ) ||
          // Action 3: Reopen completed student status
          (
            existing().status == 'completed' &&
            incoming().status == 'active' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isSignedIn() && isValidId(studentId) && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Collection: /payments/{paymentId}
    match /payments/{paymentId} {
      allow get: if isSignedIn() && isValidId(paymentId) && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(paymentId) &&
        isValidPayment(incoming()) &&
        incoming().paymentId == paymentId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/students/$(incoming().studentId)) &&
        get(/databases/$(database)/documents/students/$(incoming().studentId)).data.ownerId == request.auth.uid &&
        existsAfter(/databases/$(database)/documents/students/$(incoming().studentId));

      allow update: if isSignedIn() &&
        isValidId(paymentId) &&
        isValidPayment(incoming()) &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        incoming().paymentId == existing().paymentId &&
        incoming().studentId == existing().studentId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'paymentMode', 'referenceNo', 'installmentLabel', 'notes', 'updatedAt'
          ])
        );

      allow delete: if isSignedIn() && isValidId(paymentId) && (resource.data.ownerId == request.auth.uid || isAdmin());
    }
  }
}
