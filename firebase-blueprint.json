{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Represents an enrolled student in the 2-year Integrated Science Program (Class XI to Class XII progression across consecutive Academic Years).",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "description": "Unique identifier for the student record.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated user who owns this ledger record.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "rollNo": {
          "type": "string",
          "description": "Student Sr. No. or Roll code from the Integrated Fees Register.",
          "minLength": 1,
          "maxLength": 40
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the student.",
          "minLength": 1,
          "maxLength": 120
        },
        "fatherName": {
          "type": "string",
          "description": "Parent/guardian name or additional register identifier.",
          "minLength": 0,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Contact number.",
          "minLength": 0,
          "maxLength": 30
        },
        "stream": {
          "type": "string",
          "description": "Course stream (e.g., Science Integrated).",
          "minLength": 1,
          "maxLength": 60
        },
        "centerName": {
          "type": "string",
          "description": "Batch label or campus name.",
          "minLength": 0,
          "maxLength": 80
        },
        "enrollmentAY": {
          "type": "string",
          "description": "Academic Year in which the student enrolled in Class XI (e.g., 2025-26 or 2026-27).",
          "minLength": 7,
          "maxLength": 9,
          "pattern": "^[0-9]{4}-[0-9]{2,4}$"
        },
        "progressionAY": {
          "type": "string",
          "description": "Consecutive Academic Year in which the student automatically progresses to Class XII (e.g., 2026-27 or 2027-28).",
          "minLength": 7,
          "maxLength": 9,
          "pattern": "^[0-9]{4}-[0-9]{2,4}$"
        },
        "admissionClass": {
          "type": "string",
          "description": "Initial class of admission (XI for 2-Year Integrated, XII for Direct XII admission).",
          "enum": ["XI", "XII"]
        },
        "classXIFee": {
          "type": "number",
          "description": "Standard payable fee for Class XI (e.g., Rs 10,000)."
        },
        "classXIIFee": {
          "type": "number",
          "description": "Standard payable fee for Class XII (e.g., Rs 10,000)."
        },
        "scholarshipDiscount": {
          "type": "number",
          "description": "Concession or scholarship amount."
        },
        "totalIntegratedFee": {
          "type": "number",
          "description": "Total net payable integrated fee across Class XI and Class XII (e.g., Rs 20,000)."
        },
        "paidClassXI": {
          "type": "number",
          "description": "Amount paid for Class XI."
        },
        "paidClassXII": {
          "type": "number",
          "description": "Amount paid for Class XII."
        },
        "totalPaid": {
          "type": "number",
          "description": "Total amount paid across XI and XII (paidClassXI + paidClassXII)."
        },
        "xiPaymentDate": {
          "type": "string",
          "description": "Date of Class XI fee payment as recorded in register (e.g., 24/05/2025, May 2025, -).",
          "minLength": 0,
          "maxLength": 40
        },
        "xiiPaymentDate": {
          "type": "string",
          "description": "Date of Class XII fee payment as recorded in register (e.g., 04/04/2026, -).",
          "minLength": 0,
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "description": "Enrollment status of the student.",
          "enum": ["active", "completed", "dropped"]
        },
        "remarks": {
          "type": "string",
          "description": "Register status category / remark (e.g., Full Paid, Only XI Paid, XII Pending, XII Will Pay June 26, Direct XII Paid, Partial Paid (₹5k Due), Fee Pending, Admission Cancelled).",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "studentId",
        "ownerId",
        "rollNo",
        "fullName",
        "fatherName",
        "phone",
        "stream",
        "centerName",
        "enrollmentAY",
        "progressionAY",
        "admissionClass",
        "classXIFee",
        "classXIIFee",
        "scholarshipDiscount",
        "totalIntegratedFee",
        "paidClassXI",
        "paidClassXII",
        "totalPaid",
        "xiPaymentDate",
        "xiiPaymentDate",
        "status",
        "remarks",
        "createdAt",
        "updatedAt"
      ]
    },
    "Payment": {
      "title": "Payment",
      "description": "Represents an individual fee installment transaction.",
      "type": "object",
      "properties": {
        "paymentId": {
          "type": "string",
          "description": "Unique identifier for the payment transaction.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "description": "ID of the student in /students.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "description": "Student full name.",
          "minLength": 1,
          "maxLength": 120
        },
        "rollNo": {
          "type": "string",
          "description": "Student Sr. No. / Roll No.",
          "minLength": 1,
          "maxLength": 40
        },
        "stream": {
          "type": "string",
          "description": "Student stream.",
          "minLength": 1,
          "maxLength": 60
        },
        "enrollmentAY": {
          "type": "string",
          "description": "Student's Class XI enrollment academic year.",
          "minLength": 7,
          "maxLength": 9,
          "pattern": "^[0-9]{4}-[0-9]{2,4}$"
        },
        "progressionAY": {
          "type": "string",
          "description": "Student's Class XII progression academic year.",
          "minLength": 7,
          "maxLength": 9,
          "pattern": "^[0-9]{4}-[0-9]{2,4}$"
        },
        "recordedInAY": {
          "type": "string",
          "description": "Academic Year active when recorded.",
          "minLength": 7,
          "maxLength": 9,
          "pattern": "^[0-9]{4}-[0-9]{2,4}$"
        },
        "targetClass": {
          "type": "string",
          "description": "Fee allocation mode (XI, XII, or INTEGRATED).",
          "enum": ["XI", "XII", "INTEGRATED"]
        },
        "amount": {
          "type": "number",
          "description": "Amount paid."
        },
        "allocatedToXI": {
          "type": "number",
          "description": "Portion allocated to Class XI."
        },
        "allocatedToXII": {
          "type": "number",
          "description": "Portion allocated to Class XII."
        },
        "paymentDate": {
          "type": "string",
          "description": "Date of payment.",
          "minLength": 1,
          "maxLength": 30
        },
        "paymentMode": {
          "type": "string",
          "description": "Payment method used.",
          "enum": ["UPI", "NEFT/RTGS", "Cheque", "Cash", "Card", "DD"]
        },
        "referenceNo": {
          "type": "string",
          "description": "Reference number.",
          "minLength": 0,
          "maxLength": 80
        },
        "receiptNo": {
          "type": "string",
          "description": "Receipt number.",
          "minLength": 1,
          "maxLength": 50
        },
        "installmentLabel": {
          "type": "string",
          "description": "Installment label.",
          "minLength": 1,
          "maxLength": 80
        },
        "notes": {
          "type": "string",
          "description": "Payment notes.",
          "minLength": 0,
          "maxLength": 300
        },
        "fineAmount": {
          "type": "number",
          "description": "Optional late fee fine collected alongside tuition.",
          "minimum": 0,
          "maximum": 1000000
        },
        "receiptStatus": {
          "type": "string",
          "description": "Lifecycle status of the receipt (active or soft-reversed for audit trail).",
          "enum": ["active", "reversed"]
        },
        "reversedAt": {
          "type": "string",
          "description": "ISO timestamp or date when the receipt was reversed.",
          "minLength": 0,
          "maxLength": 40
        },
        "reversalReason": {
          "type": "string",
          "description": "Staff reason explaining why the receipt was reversed.",
          "minLength": 0,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "paymentId",
        "studentId",
        "ownerId",
        "studentName",
        "rollNo",
        "stream",
        "enrollmentAY",
        "progressionAY",
        "recordedInAY",
        "targetClass",
        "amount",
        "allocatedToXI",
        "allocatedToXII",
        "paymentDate",
        "paymentMode",
        "referenceNo",
        "receiptNo",
        "installmentLabel",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": {
        "$ref": "#/entities/Student"
      },
      "description": "Stores the 143 Integrated Register student records and any new enrollments."
    },
    "/payments/{paymentId}": {
      "schema": {
        "$ref": "#/entities/Payment"
      },
      "description": "Stores fee installment transactions across Academic Years."
    }
  }
}
